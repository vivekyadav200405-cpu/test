.vscode/
.idea/
*.swp
*.swo
*~

# ----- Logs -----
*.log
npm-debug.log*

# ----- Env files (just in case) -----
.env
.env.*
*.secret
secrets.json

# ----- Backups -----
*.bak
*.backup
*.old
